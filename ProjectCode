#include <Servo.h>
#include <LiquidCrystal.h>
#include <Keypad.h>
// LCD pins
const int RS = 2;
const int E = 3;
const int DB4 = 4;
const int DB5 = 5;
const int DB6 = 6;
const int DB7 = 7;
// Servo pin
const int SERVO_PIN = A0;
// Motion sensor, alarm and RGB LED pins
const int PIR = A5;
const int ALARM = A4;
const int RED_LED = A3;
const int BLUE_LED = A2;
const int GREEN_LED = A1;
// System states
const int UNARMED = 0;
const int ARMED = 1;
const int ALARM_STATUS = 2;
int systemState = UNARMED;
int pirState;
LiquidCrystal lcd(RS, E, DB4, DB5, DB6, DB7);
// Servo positions
const int LOCKED_POS = 0;
const int UNLOCKED_POS = 90;
Servo servo;
// Keypad: only digits 1-9 (3 rows x 3 columns)
const byte ROWS = 3;
const byte COLS = 3;
const char KEYMAP[ROWS][COLS] = {
{'1', '2', '3'},
{'4', '5', '6'},
{'7', '8', '9'},
};
const String CODE = "1235";
byte ROW_PINS[ROWS] = {13, 12, 11};
byte COL_PINS[COLS] = {10, 9, 8};
Keypad keypad = Keypad(makeKeymap(KEYMAP), ROW_PINS, COL_PINS, ROWS, COLS);
String input = "";
char key;
int failedAttempts = 0;
bool disarmScreen = false;
void setup() {
lcd.begin(16, 2);
servo.attach(SERVO_PIN);
pinMode(PIR, INPUT);
pinMode(ALARM, OUTPUT);
pinMode(RED_LED, OUTPUT);
pinMode(GREEN_LED, OUTPUT);
pinMode(BLUE_LED, OUTPUT);
updateOutputs();
}
void loop() {
readKeypad();
readPIR();
updateOutputs();
}
// readKeypad: reads keypad input, arms/disarms and triggers the alarm
void readKeypad() {
key = keypad.getKey();
if (key != NO_KEY) {
if (systemState == ALARM_STATUS) {
disarmScreen = true;
}
input += key;
if (input.length() == 4) {
if (input == CODE) {
failedAttempts = 0;
lcd.setCursor(6, 0);
lcd.print("CORRECT");
delay(500);
if (systemState == ALARM_STATUS) {
alarmOff();
systemState = UNARMED;
disarmScreen = false;
}
else if (systemState == UNARMED) {
systemState = ARMED;
}
else {
systemState = UNARMED;
}
}
else {
failedAttempts++;
lcd.setCursor(6, 0);
lcd.print("WRONG");
delay(500);
if (failedAttempts >= 3) {
systemState = ALARM_STATUS;
disarmScreen = false;
alarmOn();
}
}
input = "";
}
}
}
// readPIR: triggers the alarm if motion is seen while armed
void readPIR() {
pirState = digitalRead(PIR);
if (systemState == ARMED && pirState == HIGH) {
systemState = ALARM_STATUS;
disarmScreen = false;
alarmOn();
}
}
// updateOutputs: updates LCD, servo, LED and alarm for the current state
void updateOutputs() {
showStatus();
if (systemState == UNARMED) {
unlockDoor();
displayColor(0, 255, 0); // green
alarmOff();
}
else if (systemState == ARMED) {
lockDoor();
displayColor(255, 0, 0); // red
alarmOff();
}
else if (systemState == ALARM_STATUS) {
lockDoor();
displayColor(255, 0, 0); // red
delay(50);
displayColor(255, 255, 255); // white
delay(50);
alarmOn();
}
}
// displayColor: sets brightness of the RGB LED channels
void displayColor(int r, int g, int b) {
analogWrite(RED_LED, r);
analogWrite(GREEN_LED, g);
analogWrite(BLUE_LED, b);
}
void lockDoor() { servo.write(LOCKED_POS); } // 0 degrees
void unlockDoor() { servo.write(UNLOCKED_POS); } // 90 degrees
// showStatus: shows keypad input and status on the LCD
void showStatus() {
if (systemState != ALARM_STATUS) {
lcd.setCursor(0, 0);
lcd.print("CODE: ");
lcd.setCursor(6, 0);
lcd.print(" ");
lcd.setCursor(6, 0);
lcd.print(input);
lcd.setCursor(0, 1);
}
switch (systemState) {
case UNARMED:
lcd.print("Status: UNARMED");
break;
case ARMED:
lcd.print("Status: ARMED ");
break;
case ALARM_STATUS:
if (!disarmScreen) {
lcd.setCursor(0, 0);
lcd.print("CALLING SECURITY");
lcd.setCursor(0, 1);
lcd.print(" ***INTRUDER*** ");
}
else {
lcd.setCursor(0, 0);
lcd.print("Enter Code To ");
lcd.setCursor(0, 1);
lcd.print("Disarm: ");
lcd.print(input);
lcd.print(" ");
}
break;
}
lcd.setCursor(6, 0);
}
void alarmOn() { tone(ALARM, 500); } // siren on
void alarmOff() { noTone(ALARM); } // siren off
